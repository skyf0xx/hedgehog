{
  "name": "@skyf0xx/hedgehog",
  "version": "4.4.0",
  "description": "Install the Hedgehog build discipline (agents + skills) into a repo, for Claude Code, Cursor, or Gemini CLI.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyf0xx/hedgehog.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "hedgehog": "bin/cli.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "repro": "node --experimental-sqlite repro/run-all.mjs",
    "release": "npm version patch -m \"chore: bump version to %s\""
  },
  "files": [
    "bin",
    "src/agents",
    "src/db",
    "src/hosts",
    "src/skills",
    "src/templates",
    "src/golden-cores",
    "vendor-skills/BMAD",
    "vendor-skills/GSAP",
    "!src/golden-cores/full-stack-app/node_modules/**",
    "!src/golden-cores/full-stack-app/.nx/**",
    "!src/golden-cores/full-stack-app/apps/*/node_modules/**",
    "!src/golden-cores/full-stack-app/apps/*/dist/**",
    "!src/golden-cores/full-stack-app/apps/*/.next/**",
    "!src/golden-cores/full-stack-app/apps/*/out-tsc/**",
    "!src/golden-cores/full-stack-app/packages/*/node_modules/**",
    "!src/golden-cores/full-stack-app/packages/*/dist/**"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cursor",
    "gemini-cli",
    "agents-md",
    "agents",
    "skills",
    "scaffold",
    "hedgehog"
  ],
  "license": "MIT"
}
